  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MoskowGameJam.NPC.NPCInteractable
  npcName: Ms. Anastasia
  promptText: '[E] Talk'
  dialogueLines:
  - Welcome to my stall! The sweet aroma of freshly cooked Russian Blini is irresistible on a chilly day, isn't it?
  - Blini are thin, golden crepes. We make stacks of them during Maslenitsa festival to celebrate the return of the warm spring sun!
  - You look like someone who loves good cooking... Here, let me give you my grandma's secret Blini recipe note!
  interactDistance: 3
  greetingAudio: {fileID: 0}
  onDialogueStarted:
