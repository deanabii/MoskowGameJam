  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MoskowGameJam.NPC.NPCInteractable
  npcName: Mr. Nikolai
  promptText: '[E] Talk'
  dialogueLines:
  - Privyet, dear traveler! Come warm your hands with some freshly baked Pirozhki!
  - Pirozhki are classic Russian yeast buns, stuffed with savory fillings like braised cabbage, potato, or minced meat.
  - 'There is an old Russian saying: ''A house is celebrated not for its tall walls, but for its delicious pies!'' Enjoy!'
  interactDistance: 3
  greetingAudio: {fileID: 0}
  onDialogueStarted:
    m_PersistentCalls:
      m_Calls: []
  onDialogueFinished:
